# Copy to .env.local for local development, and set the same values in Vercel
# (Project Settings -> Environment Variables) before the first deploy.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Preferred: server-only secret key. Every query in this app runs server-side,
# so this key never reaches the browser and bypasses RLS.
SUPABASE_SECRET_KEY=

# Fallback, used only when SUPABASE_SECRET_KEY is unset. Exposed to the
# browser, so the database must have RLS policies that allow the anon role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
